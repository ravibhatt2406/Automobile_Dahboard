PORT=4001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://titan_admin:titan_secure_pass@localhost:5432/titan_auto_db?schema=public

# Redis Cache & Session Store
REDIS_URL=redis://localhost:6379

# JWT Secrets & Expiration
JWT_ACCESS_SECRET=titan_super_secret_access_key_change_in_production_2026
JWT_REFRESH_SECRET=titan_super_secret_refresh_key_change_in_production_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Email Delivery Provider (Standard SMTP / Nodemailer)
# Set EMAIL_PROVIDER=smtp and provide SMTP credentials to deliver real emails to inboxes.
# If SMTP_HOST is blank, EmailService operates in simulated mock mode (logs in-memory, no external delivery).
EMAIL_PROVIDER=auto
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password_secret
EMAIL_FROM="Titan Auto Support" <support@titanauto.com>
